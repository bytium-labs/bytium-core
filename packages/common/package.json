{
  "name": "@bytium-core/common",
  "version": "1.0.1",
  "description": "Core dependency injection, modules, and decorators for the bytium-core framework (FiveM).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bytium-labs/bytium-core.git",
    "directory": "packages/common"
  },
  "bugs": {
    "url": "https://github.com/bytium-labs/bytium-core/issues"
  },
  "homepage": "https://bytium.dev",
  "author": "Jakub Michalski - lilabyte (j.michalski@fused.pl)",
  "license": "MIT",
  "keywords": [
    "bytium",
    "fivem",
    "gta",
    "typescript",
    "framework",
    "enhanced",
    "dependency-injection",
    "decorators",
    "ioc"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "require": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./client": {
      "require": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./internal/managers/bytium-dependency.manager": {
      "require": "./dist/core/managers/bytium-dependency.manager.js",
      "types": "./dist/core/managers/bytium-dependency.manager.d.ts"
    },
    "./internal/graphs/dependency.graph": {
      "require": "./dist/core/graphs/dependency.graph.js",
      "types": "./dist/core/graphs/dependency.graph.d.ts"
    },
    "./internal/utils/apply-graph-override.utils": {
      "require": "./dist/core/utils/apply-graph-override.utils.js",
      "types": "./dist/core/utils/apply-graph-override.utils.d.ts"
    },
    "./internal/utils/scope-lookup.utils": {
      "require": "./dist/core/utils/scope-lookup.utils.js",
      "types": "./dist/core/utils/scope-lookup.utils.d.ts"
    }
  },
  "scripts": {
    "build": "node scripts/gen-version.js && rm -rf \"./dist\" && tsc --project tsconfig.build.json && tsc-alias --project tsconfig.build.json && node scripts/banner.js",
    "test": "jest --config jest.config.js"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@citizenfx/client": "^2.0.35805-1",
    "@citizenfx/server": "^2.0.35805-1",
    "ts-jest": "^29.4.14",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "jest": "^30.5.2",
    "tsc-alias": "^1.8.11",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
