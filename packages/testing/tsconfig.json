{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./src",
    "moduleResolution": "node16",
    "module": "node16",
    "types": ["@types/node", "@types/jest"],
    "paths": {
      "@testing": ["./testing/index.ts"],
      "@testing/*": ["./testing/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
