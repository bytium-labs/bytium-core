{
  "name": "@bytium-core/nui-react",
  "version": "1.0.0",
  "description": "React hooks for the bytium-core framework's NUI SDK.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bytium-labs/bytium-core.git",
    "directory": "packages/nui-react"
  },
  "bugs": {
    "url": "https://github.com/bytium-labs/bytium-core/issues"
  },
  "homepage": "https://bytium.dev",
  "author": "Jakub Michalski - lilabyte (j.michalski@fused.pl)",
  "license": "MIT",
  "keywords": [
    "bytium",
    "fivem",
    "gta",
    "typescript",
    "framework",
    "enhanced",
    "nui",
    "react",
    "hooks"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
