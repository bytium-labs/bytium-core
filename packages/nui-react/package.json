  "peerDependencies": {
    "@bytium-core/nui": "^1.0.0",
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@bytium-core/nui": "^1.0.0",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
